# PostgreSQL (Neon or another compatible provider)
DATABASE_URL=
DATABASE_URL_POOLED=

# Internal portal: set a unique username and a password of at least 16 characters.
# Serve the portal over HTTPS in production.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Stable 32-byte base64 key for encrypting credentials saved in the portal.
ADMIN_ENCRYPTION_KEY=

# Public contact link: digits only, including country code (for example 50760000000).
NEXT_PUBLIC_WHATSAPP_NUMBER=13238156876

# Meta WhatsApp Cloud API webhook (optional)
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_API_VERSION=

# S3-compatible storage for Web Editor image uploads
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_BUCKET=
